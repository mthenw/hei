# Copy to .env and fill in (gitignored). Hei reads these when it starts.

# Encrypts stored sign-ins (ChatGPT). At least 16 characters, e.g. `openssl rand -base64 32`.
HEI_SECRET=

# Claude through the Anthropic API (a pay-as-you-go key; set a monthly spend cap in the Console).
# Hei never uses a Claude subscription sign-in.
ANTHROPIC_API_KEY=

# Web search and reading pages (Jina). Without a key, chats get no web tools. A new key includes free tokens.
JINA_API_KEY=

# Finding places (Google Maps Platform). The server's key: enable Places API (New), restrict the key to it, and set a
# daily request cap. Without a key, chats get no place search.
GOOGLE_MAPS_API_KEY=

# Maps and place cards in the browser (Google's Places UI Kit). A second key, which the browser sees: enable Maps
# JavaScript API and Places UI Kit, restrict the key to those two and to Hei's addresses (website restrictions, e.g.
# http://localhost:3000/*). Without it, places show as Google Maps links only.
GOOGLE_MAPS_BROWSER_KEY=

# Optional map ID from the Google Cloud console, to style the map. Defaults to Google's test map ID.
# GOOGLE_MAPS_MAP_ID=

# Google Calendar and contacts: an OAuth client (Web application) from your Google Cloud project, with the redirect
# URI http://localhost:3000/api/calendar/google/callback, and the Calendar and People APIs enabled. See
# docs/calendar-spec.md and docs/contacts-spec.md, Setup.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Where Hei keeps its SQLite files. Defaults to ./data.
# HEI_DATA_DIR=./data
