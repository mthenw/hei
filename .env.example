# Copy to .env and fill in (gitignored). Hei reads these when it starts.

# Encrypts stored sign-ins (ChatGPT). At least 16 characters, e.g. `openssl rand -base64 32`.
HEI_SECRET=

# Claude through the Anthropic API (a pay-as-you-go key; set a monthly spend cap in the Console).
# Hei never uses a Claude subscription sign-in.
ANTHROPIC_API_KEY=

# Web search and reading pages (Jina). Used from step 6. Search requires a key; a new key includes free tokens.
JINA_API_KEY=

# Where Hei keeps its SQLite files. Defaults to ./data.
# HEI_DATA_DIR=./data
